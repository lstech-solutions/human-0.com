# Deployment (prefer GitHub OIDC with a deploy role; use static keys only if required)
AWS_REGION=us-east-2
LAMBDA_FUNCTION_NAME=your-lambda-function-name
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/github-oidc-deploy-role
UPSTREAM_BASE=https://api.human0.me
CORS_ORIGINS=*

# Optional: static credentials for local testing or legacy CI (do not commit real values)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================
# Web3 / PoSH Configuration
# ============================================

# WalletConnect Project ID (get yours at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Contract Deployment (for packages/contracts)
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Custom RPC URLs
# EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# EXPO_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ============================================
# Authentication Configuration
# ============================================

# App URL (for OAuth callbacks and magic links)
NEXT_PUBLIC_APP_URL=http://localhost:8081

# Google OAuth (get credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# Email Service (choose one: SendGrid, Resend, AWS SES, etc.)
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Resend (alternative)
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-key-min-32-chars
